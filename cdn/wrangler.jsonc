{
  "$schema": "https://unpkg.com/wrangler@4.154.0/config-schema.json",
  // The asset CDN: a Worker with static assets only (no script), so its requests and bandwidth are free.
  // It serves `cdn/dist` (`npm run cdn:build`: public/assets/ under /assets/, plus versions.json and _headers)
  // at https://ps-assets.<account>.workers.dev; the game's build points at it with VITE_ASSET_ORIGIN (src/assets.ts).
  // Deployed by `npm run cdn:deploy`, and on every push to main that touches public/assets (.github/workflows/cdn.yml).
  // A deploy replaces the whole set: never roll it back to an older one (a group's version would then name other bytes).
  "name": "ps-assets",
  "account_id": "a55a1ff9d78296b70afe6d06782d6d79",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "none", "html_handling": "none" }
}
