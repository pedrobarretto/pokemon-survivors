{
  "$schema": "https://unpkg.com/wrangler@4.154.0/config-schema.json",
  // The site's Worker: www.pokemonsurvivors.com from one origin, once the DNS moves to Cloudflare (Vercel's
  // replacement). Its static assets (free requests and bandwidth) are the whole site build, `dist/`, readied by
  // `cdn/site.mjs` (`npm run site:build`: built without VITE_ASSET_ORIGIN, so chunks and assets load from the
  // site itself, which mainland China reaches too), with its `_headers`, `_redirects` and `builds.json`.
  // The script (`worker.ts`, shared with the asset CDN) runs only for `run_worker_first`: PostHog's proxy under
  // /ingest/ (billed as Worker requests: 100k a day on the Free plan). Files, the 308s to a page's slash and the
  // 404 page (`404.html`, with its status) are the assets layer's, for free.
  // Deployed by the Site workflow (.github/workflows/site.yml). `npm run site:dev` serves dist/ locally on :8797.
  // No `routes` yet: the custom domain is attached at the cutover, so a deploy before it only reaches
  // https://ps-site.pedrobarretto.workers.dev (`workers_dev`), where `cdn/site.mjs` reads the kept builds from.
  "name": "ps-site",
  "account_id": "a55a1ff9d78296b70afe6d06782d6d79",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ingest/*"]
  }
}
