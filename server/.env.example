# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/survivors
# Clerk Dashboard → API keys → Secret key.
CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk's JWT public key (PEM), to verify tokens without fetching Clerk's keys.
# CLERK_JWT_KEY=
# Optional: extra origins allowed to call the API, comma separated (www.pokemonsurvivors.com and localhost always are).
# CORS_ORIGINS=https://pokemon-survivors-git-feat-accounts.vercel.app
PORT=3000
# Optional: verified emails (comma separated) whose owners get the admin gift desk. Empty: nobody is admin.
# ADMIN_EMAILS=pedro@barretto.com.br
# Optional: the secret the co-op relay signs Arena reports and ticket lookups with (the same on the relay). Unset: those routes answer 503.
# ARENA_REPORT_SECRET=
