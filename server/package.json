{
  "name": "pokemon-survivors-api",
  "private": true,
  "type": "module",
  "description": "Accounts API for Pokémon Survivors: saves synced per player (Hono + Postgres + Clerk).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts src/verify.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "rules:freeze": "node scripts/freeze-rules.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.18",
    "postgres": "^3.4.9",
    "posthog-node": "^5.56.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
