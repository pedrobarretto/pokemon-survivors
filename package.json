{
  "name": "pokemon-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node cdn/deploy.mjs assets && vite build && node scripts/sourcemaps.mjs && node cdn/deploy.mjs site",
    "preview": "vite preview",
    "cdn:build": "node cdn/build.mjs",
    "cdn:dev": "node cdn/build.mjs --fresh && CHOKIDAR_USEPOLLING=true npx --yes wrangler@4.154.0 dev --config cdn/wrangler.jsonc --port 8796",
    "cdn:deploy": "node cdn/deploy.mjs assets --force",
    "site:build": "tsc --noEmit && vite build && node scripts/sourcemaps.mjs && node cdn/site.mjs",
    "site:dev": "CHOKIDAR_USEPOLLING=true npx --yes wrangler@4.154.0 dev --config cdn/site.wrangler.jsonc --port 8797",
    "site:parity": "node scripts/site-parity.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "roster": "node scripts/roster.mjs",
    "assets": "node scripts/fetch-assets.mjs && node scripts/fetch-emotes.mjs",
    "credits": "node scripts/credits.mjs",
    "creators": "node scripts/creators.mjs",
    "bodies": "node scripts/bodies.mjs",
    "determinism": "node scripts/determinism.mjs",
    "rules:freeze": "npm run rules:freeze --prefix server",
    "soak": "node scripts/coop/soak.mjs",
    "dig-shapes": "node scripts/dig-shapes.mjs",
    "fossils": "node scripts/fetch-fossils.mjs",
    "rig": "node scripts/rig.mjs",
    "rig:migrate": "node scripts/rig-migrate.mjs",
    "fit-check": "node scripts/fit-check.mjs",
    "skins": "node scripts/skins.mjs",
    "skin": "node scripts/skinAuthor.mjs"
  },
  "devDependencies": {
    "@posthog/cli": "^0.19.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.42.0",
    "@clerk/shared": "^4.40.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "fflate": "^0.8.3",
    "opencc-js": "^1.4.2",
    "posthog-js": "^1.441.2"
  },
  "license": "MIT",
  "homepage": "https://www.pokemonsurvivors.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobarretto/pokemon-survivors.git"
  },
  "bugs": {
    "url": "https://github.com/pedrobarretto/pokemon-survivors/issues"
  }
}
