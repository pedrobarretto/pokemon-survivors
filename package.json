{
  "name": "pokemon-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/sourcemaps.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "roster": "node scripts/roster.mjs",
    "assets": "node scripts/fetch-assets.mjs && node scripts/fetch-emotes.mjs",
    "credits": "node scripts/credits.mjs",
    "bodies": "node scripts/bodies.mjs",
    "determinism": "node scripts/determinism.mjs",
    "rules:freeze": "npm run rules:freeze --prefix server",
    "soak": "node scripts/coop/soak.mjs"
  },
  "devDependencies": {
    "@posthog/cli": "^0.16.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.39.0",
    "@clerk/shared": "^4.40.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "fflate": "^0.8.3",
    "posthog-js": "^1.438.12"
  },
  "license": "MIT",
  "homepage": "https://www.pokemonsurvivors.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobarretto/pokemon-survivors.git"
  },
  "bugs": {
    "url": "https://github.com/pedrobarretto/pokemon-survivors/issues"
  }
}
