    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.154.0"
  }
}
